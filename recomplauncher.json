{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "SkywardRecomp",
  "repo": "Ramasanjaya22/SkywardRecomp",
  "inputs": [
    {
      "id": "game",
      "label": "Your Skyward Sword HD 1.0.0 base game (01002DA013484000, v0, no update): its .nsp, or a folder with its exefs and romfs.",
      "role": "game",
      "formats": [
        { "type": "folder" },
        { "type": "file", "extensions": ["nsp"], "requires": ["keys"] }
      ]
    },
    { "id": "keys", "label": "Your Switch's prod.keys, to open the .nsp", "role": "key", "shared": "switch.prod-keys" }
  ],
  "prepare": {
    "program": ["skywardrecomp.exe", "SkywardRecomp.app", "SkywardRecomp-linux-x86_64.AppImage"],
    "args": ["--prepare", "--game={input:game}", "--keys={input:keys}"],
    "env": { "LARECOMP_DATA_ROOT": "{data}" },
    "label": "Building the game code from your copy (a few minutes)",
    "timeout": 3600,
    "version": "v0.8.0",
    "done": ["{data}/extracted/exefs/main", "{data}/extracted/skywardgame.dll.id"],
    "keeps_copy": true
  },
  "start": {
    "program": ["skywardrecomp.exe", "SkywardRecomp.app", "SkywardRecomp-linux-x86_64.AppImage"],
    "args": ["--play"],
    "env": { "LARECOMP_DATA_ROOT": "{data}", "LARECOMP_NO_UPDATE_CHECK": "1" }
  },
  "saves": ["{data}/save", "{data}/skywardrecomp.ini"],
  "system": {
    "windows": { "version": "10", "graphics": { "vulkan": "1.3" } },
    "linux": { "glibc": "2.35", "graphics": { "vulkan": "1.3" } }
  },
  "config": [
    { "id": "main", "format": "ini", "file": [{ "path": "{data}/skywardrecomp.ini" }] }
  ],
  "settings": [
    {
      "id": "fullscreen", "label": "Window Mode", "group": "Display",
      "help": "A window you can resize, or the whole screen.",
      "choices": [
        { "label": "Window", "set": { "fullscreen": "0" } },
        { "label": "Full Screen", "set": { "fullscreen": "1" } }
      ],
      "defaults": { "fullscreen": "0" }
    },
    {
      "id": "aspect", "label": "Aspect Ratio", "group": "Display",
      "help": "Fill the window shows more on the sides of an ultrawide screen. 16:9 is the Switch's picture, with bars.",
      "choices": [
        { "label": "Fill the Window", "set": { "aspect": "unlocked" } },
        { "label": "16:9", "set": { "aspect": "original" } }
      ],
      "defaults": { "aspect": "unlocked" }
    },
    {
      "id": "resolution", "label": "Resolution", "group": "Graphics",
      "help": "What the game draws at. 1x is the Switch's own; Auto picks for your graphics card.",
      "choices": [
        { "label": "Auto", "set": { "resolution": "auto" } },
        { "label": "Match the Window", "set": { "resolution": "match" } },
        { "label": "1x", "set": { "resolution": "1x" } },
        { "label": "2x", "set": { "resolution": "2x" } },
        { "label": "3x", "set": { "resolution": "3x" } },
        { "label": "4x", "set": { "resolution": "4x" } }
      ],
      "defaults": { "resolution": "auto" }
    },
    {
      "id": "upscaler", "label": "Upscaling", "group": "Graphics",
      "help": "How the picture is scaled to your window. Sharp is AMD FSR 1 on Windows and Linux, MetalFX on a Mac.",
      "choices": [
        { "label": "Auto", "set": { "upscaler": "auto" } },
        { "label": "Sharp", "set": { "upscaler": "fsr1" } },
        { "label": "Smooth", "set": { "upscaler": "bilinear" } }
      ],
      "defaults": { "upscaler": "auto" }
    },
    {
      "id": "antialias", "label": "Anti-Aliasing", "group": "Graphics",
      "help": "SMAA smooths jagged edges.",
      "choices": [
        { "label": "Off", "set": { "antialias": "off" } },
        { "label": "SMAA", "set": { "antialias": "smaa" } }
      ],
      "defaults": { "antialias": "off" }
    },
    {
      "id": "shadows", "label": "Shadows", "group": "Graphics",
      "help": "High draws sharper shadows than the Switch.",
      "choices": [
        { "label": "Switch", "set": { "shadows": "default" } },
        { "label": "High", "set": { "shadows": "high" } }
      ],
      "defaults": { "shadows": "default" }
    },
    {
      "id": "ambient_occlusion", "label": "Ambient Occlusion", "group": "Graphics",
      "help": "Soft shading where surfaces meet.",
      "choices": [
        { "label": "Switch", "set": { "ambient_occlusion": "switch" } },
        { "label": "High", "set": { "ambient_occlusion": "high" } },
        { "label": "Off", "set": { "ambient_occlusion": "off" } }
      ],
      "defaults": { "ambient_occlusion": "switch" }
    },
    {
      "id": "show_fps", "label": "Frame Rate Counter", "group": "Graphics", "advanced": true,
      "help": "Shows the frame rate in a corner.",
      "choices": [
        { "label": "Off", "set": { "show_fps": "0" } },
        { "label": "On", "set": { "show_fps": "1" } }
      ],
      "defaults": { "show_fps": "0" }
    },
    {
      "id": "volume", "label": "Volume", "group": "Audio",
      "slider": { "key": "volume", "min": 0, "max": 2, "step": 0.05, "format": "%.2f" },
      "defaults": { "volume": "1.00" }
    },
    {
      "id": "prompts", "label": "Button Prompts", "group": "Controls",
      "help": "Which buttons the game shows. Auto follows the controller you use.",
      "choices": [
        { "label": "Auto", "set": { "prompts": "auto" } },
        { "label": "Nintendo", "set": { "prompts": "nintendo" } },
        { "label": "Xbox", "set": { "prompts": "xbox" } },
        { "label": "PlayStation", "set": { "prompts": "playstation" } }
      ],
      "defaults": { "prompts": "auto" }
    }
  ],
  "folders": {
    "game": [{ "path": "{data}/extracted" }],
    "saves": [{ "path": "{data}/save" }],
    "logs": [
      { "path": "{data}", "if": "{data}/skywardrecomp.log" },
      { "path": "{install}" }
    ]
  },
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your save slots.", "open": "saves" },
    { "id": "logs", "label": "Logs", "help": "skywardrecomp.log is the latest run.", "open": "logs" }
  ]
}
